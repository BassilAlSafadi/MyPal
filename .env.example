# MyPal Service Discovery
GO_GATEWAY_URL=http://localhost:8080
GO_SUPPORT_URL=http://localhost:5001
NODE_ORCHESTRATOR_URL=http://localhost:5002
PRODBERT_URL=http://localhost:8001
CSHARP_MAIN_API_URL=http://localhost:5000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mypal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_URL=postgresql://postgres:CHANGE_ME@localhost:5432/mypal
PGVECTOR_ENABLED=true

# MongoDB
MONGO_URI=mongodb://localhost:27017/mypal

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers
GEMINI_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=

# JWT & Auth
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
SESSION_SECRET=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend (Vite)
VITE_API_GATEWAY=http://localhost:8080
VITE_NODE_ORCHESTRATOR=http://localhost:5002
VITE_PRODBERT=http://localhost:8001

# Other
PRODBERT_MODEL=sentence-transformers/paraphrase-MiniLM-L3-v2
PRODBERT_PORT=8001
GO_SERVER_PORT=5001
NODE_ORCHESTRATOR_PORT=5002
ENABLE_LLM_FALLBACK=true
