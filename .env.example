# MyPal Service Discovery
#
# Six services, called directly by the SPA — there is no gateway.
AUTH_SERVICE_URL=http://localhost:5000
MESSAGING_SERVICE_URL=http://localhost:5001
LISTINGS_SERVICE_URL=http://localhost:5002
AI_SERVICE_URL=http://localhost:5003
ORDERS_SERVICE_URL=http://localhost:5004
PAYMENTS_SERVICE_URL=http://localhost:5005
PRODBERT_URL=http://localhost:8001

# PostgreSQL — three databases on one server.
#   mypal_auth     → auth
#   mypal_listings → listings (also holds product_embeddings / pgvector)
#   mypal_orders   → orders AND payments, deliberately shared so an order insert
#                    and its wallet debit stay in one transaction
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
AUTH_POSTGRES_URL=Host=localhost;Port=5432;Database=mypal_auth;Username=postgres;Password=CHANGE_ME
LISTINGS_POSTGRES_URL=Host=localhost;Port=5432;Database=mypal_listings;Username=postgres;Password=CHANGE_ME
ORDERS_POSTGRES_URL=Host=localhost;Port=5432;Database=mypal_orders;Username=postgres;Password=CHANGE_ME
PAYMENTS_POSTGRES_URL=Host=localhost;Port=5432;Database=mypal_orders;Username=postgres;Password=CHANGE_ME
PGVECTOR_ENABLED=true

# MongoDB — one database per Go service.
AI_MONGO_URL=mongodb://localhost:27017
AI_MONGO_DB=mypal_ai
MESSAGING_MONGO_URL=mongodb://localhost:27017
MESSAGING_MONGO_DB=mypal_messaging

# Redis — every service caches reads here with a 5 hour TTL.
REDIS_URL=redis://localhost:6379

# NATS — optional. Unset means the orders outbox still records events durably
# but the dispatcher stays off.
NATS_URL=nats://localhost:4222

# AI Providers — an unset key degrades that node to its mock response.
# GEMINI_API_KEY powers every chat model (gemini-3.6-flash / gemini-3.1-pro-preview).
# HUGGING_FACE_API_KEY is only for the Prompt-Guard security classifier and the embed service.
GEMINI_API_KEY=
TAVILY_API_KEY=
HUGGING_FACE_API_KEY=

# JWT & Auth — the auth service issues tokens; every other service validates
# them with the same secret.
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=3650d
SESSION_SECRET=CHANGE_ME
# Guards the /internal/* routes services call on each other.
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# Google OAuth — the callback is registered against the auth service.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend (Vite) — one base URL per service. Leave empty in local dev so the
# Vite proxy in Frontend/vite.config.ts routes each path to the right port.
VITE_AUTH_URL=
VITE_LISTINGS_URL=
VITE_ORDERS_URL=
VITE_PAYMENTS_URL=
VITE_AI_URL=
VITE_MESSAGING_URL=
FRONTEND_URL=http://localhost:5173

# Other
PRODBERT_MODEL=sentence-transformers/paraphrase-MiniLM-L3-v2
PRODBERT_PORT=8001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
