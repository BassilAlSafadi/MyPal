# Dockerfile for the MyPal API Gateway (cmd/gateway).
# Requires the proto/ directory to be present in the build context alongside go/.
FROM golang:1.24-alpine AS builder
ENV GOTOOLCHAIN=auto CGO_ENABLED=0
WORKDIR /app
COPY . .
RUN go mod download
RUN go build -o gateway ./cmd/gateway

FROM alpine:latest
RUN apk add --no-cache ca-certificates
WORKDIR /root/
COPY --from=builder /app/gateway .
EXPOSE 10000
CMD ["./gateway"]
