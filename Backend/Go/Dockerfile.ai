# AI service — the Go port of the former Node.js orchestrator.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/ai ./cmd/ai

FROM alpine:3.20
RUN apk add --no-cache ca-certificates curl
WORKDIR /app
COPY --from=build /out/ai .
EXPOSE 5003
ENTRYPOINT ["/app/ai"]
