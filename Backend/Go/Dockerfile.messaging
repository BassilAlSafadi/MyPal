# Messaging service — chat threads, support tickets and negotiations on MongoDB.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/messaging ./cmd/messaging

FROM alpine:3.20
RUN apk add --no-cache ca-certificates curl
WORKDIR /app
COPY --from=build /out/messaging .
EXPOSE 5001
ENTRYPOINT ["/app/messaging"]
