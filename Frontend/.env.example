# MyPal service endpoints
#
# The SPA calls the six microservices directly — there is no gateway to point at
# any more, so there is one base URL per service.
#
# Leave them all empty for dev/Codespaces: requests then use relative paths and
# the Vite proxy in vite.config.ts routes each one to the right local port.
# For production builds, set each to that service's absolute public URL.
VITE_AUTH_URL=
VITE_LISTINGS_URL=
VITE_ORDERS_URL=
VITE_PAYMENTS_URL=
VITE_AI_URL=
VITE_MESSAGING_URL=

# Supabase (Auth/Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mode
VITE_ENV=development
