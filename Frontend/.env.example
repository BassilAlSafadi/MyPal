# MyPal public endpoint
# All canonical API traffic must go through the Go Gateway.
# Leave empty for dev/Codespaces (requests go through the Vite proxy in
# vite.config.ts). Set to the gateway's absolute URL for production builds.
VITE_API_GATEWAY=

# Supabase (Auth/Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mode
VITE_ENV=development
