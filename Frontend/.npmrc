registry=https://registry.npmjs.org/
strict-ssl=false

# Network resiliency (kept). NOTE: maxsockets/prefer-offline/ignore-scripts
# removed 2026-05-30 — they were causing npm optional-dep bug (#4828) to drop
# platform binaries (@rollup/*-msvc, esbuild) and skip postinstall steps.
fetch-retries=3
fetch-retry-factor=2
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=30000
fetch-timeout=120000
